{
  "my-app": {
    "repo": "you/my-app",
    "cloneUrl": "https://github.com/you/my-app.git",
    "pm": "npm",
    "install": [
      "npm",
      "ci"
    ],
    "verify": [
      {
        "name": "typecheck",
        "cmd": [
          "npx",
          "tsc",
          "--noEmit"
        ]
      }
    ],
    "safePaths": [
      "src/**",
      "public/**"
    ],
    "defaultModel": "omen-alpha",
    "allowedModels": [
      "omen-alpha",
      "muse-spark-1.3-contributor",
      "deepseek-v4-flash"
    ]
  }
}
