{
  "my-app": {
    "repo": "you/my-app",
    "reviewer": "your-github-login",
    "cloneUrl": "https://github.com/you/my-app.git",
    "pm": "npm",
    "install": [
      "npm",
      "ci"
    ],
    "verify": [
      {
        "name": "typecheck",
        "cmd": [
